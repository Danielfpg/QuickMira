<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #f4f6f9;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.quickmira.Controller.ControladorInventoryView">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="15.0" style="-fx-background-color: #2271b3; -fx-padding: 10;">
            <children>
                <Label text="Inventario General" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="labelBDActiva" text="Base de Datos Activa" textFill="WHITE" />
                <ToggleButton fx:id="btnSQLite" text="SQLite" />
                <ToggleButton fx:id="btnMySQL" text="MySQL" />
                <ToggleButton fx:id="btnMongoDB" text="MongoDB" />
            </children>
        </HBox>
    </top>

    <left>
        <VBox prefWidth="130.0" spacing="10" style="-fx-background-color: #ffffff; -fx-border-color: #dce1e7; -fx-border-width: 0 1 0 0;" BorderPane.alignment="CENTER">
            <padding><Insets top="20.0" left="5.0" right="5.0"/></padding>
            <children>
                <Button fx:id="inventory" alignment="CENTER_LEFT" prefHeight="45.0" prefWidth="120.0" text="Inventory" />
                <Button fx:id="sell" alignment="CENTER_LEFT" prefHeight="45.0" prefWidth="120.0" text="Sell" />
                <Button fx:id="stadistics" alignment="CENTER_LEFT" prefHeight="45.0" prefWidth="120.0" text="Stadistics" />
                <Region VBox.vgrow="ALWAYS" />
                <Button fx:id="Clouse_sesion" alignment="CENTER" prefHeight="30.0" prefWidth="120.0" text="Cerrar Sesión" />
            </children>
        </VBox>
    </left>

    <center>
        <VBox spacing="10.0" style="-fx-padding: 15;">
            <children>
                <HBox spacing="10.0">
                    <children>
                        <Button text="Editar Producto" onAction="#handleEditar" style="-fx-background-color: #f39c12; -fx-text-fill: white;" />
                        <Button text="Eliminar Producto" onAction="#handleEliminar" style="-fx-background-color: #e74c3c; -fx-text-fill: white;" />
                        <Button text="Recargar" onAction="#handleRecargar" style="-fx-background-color: #3498db; -fx-text-fill: white;" />
                        <Button fx:id="btnBackup" text="Ver Backups" onAction="#handleVerBackup" style="-fx-background-color: #9b59b6; -fx-text-fill: white;" />
                    </children>
                </HBox>

                <TableView fx:id="tablaProductos" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCodigo" prefWidth="80.0" text="ID / Código" />
                        <TableColumn fx:id="colNombre" prefWidth="200.0" text="Nombre del Producto" />
                        <TableColumn fx:id="colPrecio" prefWidth="120.0" text="Precio Unitario" />
                        <TableColumn fx:id="colCantidad" prefWidth="100.0" text="Stock" />
                        <TableColumn fx:id="colImagen" prefWidth="150.0" text="Ruta Imagen" />
                    </columns>
                </TableView>
            </children>
        </VBox>
    </center>

    <bottom>
        <HBox spacing="40" style="-fx-padding: 10; -fx-background-color: #eef1f5; -fx-border-color: #dce1e7; -fx-border-width: 1 0 0 0;">
            <children>
                <Label fx:id="labelTotalProductos" text="Total de productos: -" />
                <Label fx:id="labelStockBajo" text="Productos en stock bajo: -" />
                <Label fx:id="labelValorTotal" text="Valor total inventario: -" />
            </children>
        </HBox>
    </bottom>
</BorderPane>